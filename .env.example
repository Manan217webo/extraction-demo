# Document reading. "vision" (default): the PDF is rendered to page images on
# this server and the field model reads them directly — no parsing service.
# "llamaparse": the original LlamaCloud parse (needs LLAMA_CLOUD_API_KEY).
# PARSER=vision
# MAX_PAGES=30
# LLAMA_CLOUD_API_KEY=llx-your-key-here

# Field extraction, used to map a read document onto a CRF.
OPENAI_API_KEY=sk-your-key-here
# Any chat-completions model. Defaults to gpt-4o when unset. It reads the page
# images, so it must accept images; handwriting and strike-throughs read far
# better on a frontier model than on a mini one.
OPENAI_MODEL=gpt-4o
# An independent second read of every CRF, run in parallel. Fields where the two
# reads disagree are flagged and scored low. Defaults to OPENAI_MODEL; a
# different model makes the reads more independent. "off" disables it (halves
# the cost, loses the agreement check).
# OPENAI_SECOND_READ_MODEL=gpt-5.6-terra
# When the two reads disagree, the bigger model's value stands (and it is the
# read that places boxes). The size is guessed from the names (nano < mini <
# standard < pro/large); say it outright when the names don't tell:
# OPENAI_PREFERRED_READ=first   # OPENAI_MODEL is the bigger one
# OPENAI_PREFERRED_READ=second  # OPENAI_SECOND_READ_MODEL is the bigger one
# Box placement. Set to gpt-5.6-terra to look at the page (~$0.05–$0.20 per
# 2–3 page document; extra boxes on the same pages barely change the bill).
# Leave unset to use free local Tesseract instead.
# OPENAI_VISION_MODEL=gpt-5.6-terra
# TESSERACT_CMD=

# Cronos. Leave CRONOS_BASE_URL unset to use the sample CRF definitions in
# cronos_forms/; set it and the real connector is used instead.
# CRONOS_BASE_URL=https://cronos.internal.example.com
# CRONOS_API_KEY=

# Cronos EDC. In production APP_ENV=production requires an explicit customer
# host — the Cronos dev default is refused. EDC_FIXTURES points the connector
# at a local JSON file instead (demo only; must be unset in production).
# EDC_BASE_URL=https://cronosedc.dev.cronos.ws
# EDC_API_KEY=
# EDC_FIXTURES=edc_fixtures/visits.json

# ---------------------------------------------------------------------------
# Multi-user / production

# development (default) | production — production refuses to start without
# Redis, users, a real EDC_BASE_URL, and a vision backend; fixtures off.
# APP_ENV=production

# Redis holds login sessions and per-job review state across workers/restarts.
# REDIS_URL=redis://localhost:6379/0

# The system of record (documents, versions, drafts, signatures, submissions,
# audit trail). PostgreSQL in production; unset = a SQLite file in ./data for
# development only.
# DATABASE_URL=postgresql+asyncpg://esource:<password>@localhost:5432/esource
# Where original source PDFs are kept, write-once, by SHA-256. Encrypted,
# backed-up volume. Default ./data
# DATA_DIR=/data

# Accounts live in the database. Create the first admin with:
#   uv run scripts/add_user.py alice --full-name "Alice Ng" --role admin
# Roles: reviewer (review, sign, submit), monitor (read-only incl. audit), admin.
# A legacy users.json (USERS_FILE) is imported once at start-up.
# SESSION_IDLE_MINUTES=15
# SESSION_MAX_HOURS=12
# LOGIN_MAX_FAILED=5
# LOGIN_LOCK_MINUTES=30
# PASSWORD_MIN_LENGTH=12

# Audit trail. Each event's hash covers the one before it; with this key set
# the hash is an HMAC, so database access alone can't rewrite history.
# Required in production. Keep it out of the database and back it up.
# AUDIT_HMAC_KEY=<long random string>
# Deliver the audit trail to the EDC. Unset = kept locally ("held") and
# released, oldest first, once set. Records follow CDISC ODM AuditRecord names.
# EDC_AUDIT_URL=https://edc.example.com/api/EDC/AuditRecords
# EDC_AUDIT_API_KEY=
# Let the EDC fetch the trail itself: GET /api/edc/audit with
# "Authorization: Bearer <key>". Unset = the endpoint answers 404. Several
# keys, comma-separated, allow rotation. Generate with: openssl rand -hex 32
# EDC_PULL_API_KEY=

# File-server sources reviewers can browse and scan (see sources.example.json).
# SOURCES_FILE=sources.json
# SCAN_MAX_FILES=2000
# Batch processing: runs inside the web process unless WORKER_IN_PROCESS=0
# (then run `uv run worker.py`; docker-compose does this for you).
# WORKER_IN_PROCESS=1
# WORKER_CONCURRENCY=2

# Proxies whose X-Forwarded-For is trusted for the client IP recorded in the
# audit trail (comma-separated IPs/CIDRs of your reverse proxy). Anything else
# is ignored, so a client can't choose the address it is recorded under.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Comma-separated hostnames when running behind a reverse proxy.
# ALLOWED_HOSTS=extraction.example.com,localhost

# Restrict which extraction modes appear in the UI (optional).
# ALLOWED_MODES=high,standard

# Cap concurrent OpenAI/vision reads per worker (default 3).
# MAX_CONCURRENT_READS=3

# Uvicorn workers (default 2 in production / Docker).
# WEB_CONCURRENCY=2

# How long Redis keeps a job's meta and parse cache (default 7).
# JOB_TTL_DAYS=7
